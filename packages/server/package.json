{
  "name": "@nmhossain02/tourguide",
  "version": "0.2.0",
  "description": "Generate and explore interactive, Codex-authored tours of Git codebases.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "bin": {
    "tourguide": "dist/tourguide.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts open ../..",
    "build": "tsup && node ../../scripts/sync-distribution.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@fastify/static": "latest",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tourguide/core": "workspace:*",
    "fastify": "latest",
    "open": "latest",
    "zod": "^4.0.0",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
